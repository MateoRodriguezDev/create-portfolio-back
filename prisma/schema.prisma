// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

model User {
  id   Int    @id @default(autoincrement()) @db.UnsignedInt
  uid  String @unique
  role Role   @default(user)

  active Boolean @default(true)

  profile UserProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model UserProfile {
  id                Int    @id @default(autoincrement()) @db.UnsignedInt
  fullName          String @db.VarChar(100)
  userName          String @db.VarChar(100)
  profilePictureURL String @db.VarChar(255)
  backgroundURL  String? @db.VarChar(255)

  active Boolean @default(true)

  titleId Int?
  title   Title? @relation(fields: [titleId], references: [id])

  links    Link[]
  projects Project[]

  userId Int  @db.UnsignedInt
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Title {
  id           Int           @id @default(autoincrement())
  titleName    String        @db.VarChar(100)
  descripcion  String?       @db.Text
  titleIconURL String?       @db.Text
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now())
  userProfiles UserProfile[]
}

model Link {
  id          Int     @id @default(autoincrement())
  url         String  @db.VarChar(255)
  descripcion String? @db.VarChar(255)

  userProfileId Int         @db.UnsignedInt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TechCategory {
  id               Int     @id @default(autoincrement())
  techCategoryName String  @db.VarChar(50)
  imgURL           String? @db.VarChar(255)
  descripcion      String? @db.VarChar(255)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  Technologies Technology[]
}

model Technology {
  id          Int     @id @default(autoincrement())
  techName    String  @db.VarChar(50)
  imgURL      String  @db.VarChar(255)
  descripcion String? @db.VarChar(255)

  techCategoryId Int
  techCategory   TechCategory @relation(fields: [techCategoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  projects ProjectTechnology[]
}

model Project {
  id          Int     @id @default(autoincrement())
  projectName String  @db.VarChar(50)
  projectURL  String? @db.VarChar(255)
  imgURL      String  @db.VarChar(255)
  descripcion String? @db.VarChar(255)

  active Boolean @default(true)

  userProfileId Int         @db.UnsignedInt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  technologies ProjectTechnology[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ProjectTechnology {
  projectId    Int
  technologyId Int

  project    Project    @relation(fields: [projectId], references: [id])
  technology Technology @relation(fields: [technologyId], references: [id])

  @@id([projectId, technologyId])
}
